# SDL-dlink smoke test: plain homebrew NRO that loads sdl3.dnro at runtime.
# hostneed.mk is generated by ../build.sh (linker -u roots forcing every
# symbol sdl3.dnro + neko3d.dnro import into this host, so
# dlink_register_host() can expose them). Always build via ../build.sh
# --smoke; direct `make` only works after hostneed.mk exists.

TOP := $(CURDIR)
SDL := $(TOP)/..
DLINK := $(SDL)/extern/libnx-dlink

DEVKITPRO ?= /opt/devkitpro
DKA64 := $(DEVKITPRO)/devkitA64
CC := $(DKA64)/bin/aarch64-none-elf-gcc

APP_TITLE := SDL3 Smoke
APP_AUTHOR := qlaunch-ext
APP_VERSION := 0.1.0

TARGET := smoke
BUILD := $(TOP)/build

ARCH := -march=armv8-a -mtune=cortex-a57 -mtp=soft -fPIC
CFLAGS := -g -O2 -ffunction-sections -fdata-sections $(ARCH) -D__SWITCH__ \
          -I$(DEVKITPRO)/libnx/include -I$(SDL)/include -I$(DLINK)/include
LDFLAGS := -specs=$(DEVKITPRO)/libnx/switch.specs -g $(ARCH) -Wl,--export-dynamic \
           -Wl,--gc-sections -Wl,-Map,$(TOP)/smoke.map
LIBS := -L$(DLINK)/lib -L$(DEVKITPRO)/libnx/lib -ldlink -lm -lnx

NROFLAGS := --nacp=$(TOP)/$(TARGET).nacp

OBJS := $(BUILD)/main.o

-include $(TOP)/hostneed.mk
LDFLAGS += $(HOSTNEEDFLAGS)

all: $(TOP)/$(TARGET).nro

$(TOP)/$(TARGET).nro: $(TOP)/$(TARGET).elf $(TOP)/$(TARGET).nacp
	$(DEVKITPRO)/tools/bin/elf2nro $< $@ $(NROFLAGS)

$(TOP)/$(TARGET).nacp:
	$(DEVKITPRO)/tools/bin/nacptool --create "$(APP_TITLE)" "$(APP_AUTHOR)" "$(APP_VERSION)" $@

$(TOP)/$(TARGET).elf: $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

$(BUILD)/%.o: $(TOP)/%.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -rf $(BUILD) $(TOP)/$(TARGET).elf $(TOP)/$(TARGET).nro \
	       $(TOP)/$(TARGET).nacp $(TOP)/smoke.map

.PHONY: all clean
